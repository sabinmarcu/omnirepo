{
  "manifest_version": 3,
  "name": "Sabin Marcu Theme Devtools",
  "description": "Inspect and edit @sabinmarcu/theme-core source values from Chrome DevTools.",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "devtools_page": "devtools.html",
  "permissions": ["scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
