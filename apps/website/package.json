    "@sabinmarcu/moving-mesh-background": "workspace:*",
    "@sabinmarcu/theme": "workspace:*",
    "@sabinmarcu/utils-string": "workspace:^",
    "@sabinmarcu/website-theme": "workspace:*",
    "@tscircuit/routematch": "^1.0.1",
    "@types/mdx": "^2.0.13",
    "@vanilla-extract/css": "^1.17.1",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/next-plugin": "^2.4.10",
    "@vanilla-extract/recipes": "^0.5.7",
    "codehike": "^1.0.7",
    "critters": "^0.0.25",
    "date-fns": "^4.1.0",
    "moize": "^6.1.7",
    "next": "16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "remark-heading-id": "^1.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-mdx-toc": "^0.3.1",
    "ts-reset": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@sabinmarcu/types": "workspace:*",
    "@sabinmarcu/utils-test": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "typescript": "^6.0.2"
  },
  "tscmono": {
    "preset": "nextApp"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme": "./config/theme.ts",
    "./src/*": {
      "import": "./src/*",
      "default": "./src/*"
    },
    "./*": {
      "import": "./dist/*.js",
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typeVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  }
}
