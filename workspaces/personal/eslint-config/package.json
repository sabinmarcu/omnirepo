{
  "name": "@sabinmarcu/eslint-config",
  "version": "3.4.2",
  "dependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "confusing-browser-globals": "^1.0.11",
    "debug": "^4.4.3",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-canonical": "^5.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-logical-properties": "workspace:*",
    "eslint-plugin-unicorn": "^73.0.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "ts-deepmerge": "^8.0.0"
  },
  "devDependencies": {
    "@sabinmarcu/types": "workspace:*",
    "@sabinmarcu/utils-test": "workspace:*",
    "@types/confusing-browser-globals": "^1",
    "@types/debug": "^4",
    "@types/eslint": "^9.6.1",
    "@types/eslint__eslintrc": "^3.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./src/*": {
      "import": "./src/*",
      "default": "./src/*"
    },
    "./*": {
      "import": "./dist/*.js",
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "build": {
    "preset": "../../../.config/build.config.ts"
  },
  "tscmono": {
    "preset": "lib"
  },
  "typeVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-expect-type": "^0.6.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.7",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "eslint-plugin-expect-type": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-storybook": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "repository": {
    "url": "git+https://github.com/sabinmarcu/omnirepo.git",
    "type": "git",
    "directory": "workspaces/personal/eslint-config"
  },
  "homepage": "https:/sabinmarcu.dev/api/eslint-config"
}
